{
  "name": "(zh-CN)Refined PrUn OOG",
  "version": "1.1.11.1",
  "description": "基于 OOG 版 Refined PrUn 的汉化扩展，优化 Prosperous Universe 界面并提供实用功能",
  "manifest_version": 3,
  "minimum_chrome_version": "107",
  "browser_specific_settings": {
    "gecko": {
      "id": "refined-prun-cn@hycnyl.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "searchTerms",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://apex.prosperousuniverse.com/"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apex.prosperousuniverse.com/*"
      ],
      "js": [
        "refined-prun-prepare.js",
        "refined-prun-startup.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "*.svg",
        "*.json",
        "*.woff2",
        "*.ttf"
      ],
      "matches": [
        "https://apex.prosperousuniverse.com/*"
      ]
    }
  ],
  "version_name": "1.1.11-cn.1",
  "homepage_url": "https://github.com/Hycnyl/Refined-PrUn"
}
